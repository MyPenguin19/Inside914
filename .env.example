# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Supabase dashboard > Project Settings > API / API Keys.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Local development: use Stripe test keys only. Production uses launch prices.
# Stripe Dashboard (Test mode) > Developers > API keys / Webhooks.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx

# Email (Resend). Optional: without a key, confirmation emails stay queued in email_outbox.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Inside914 <no-reply@inside914.com>
SUPPORT_EMAIL=support@inside914.com

# Production requires APP_URL=https://inside914.vercel.app. Preview needs its own accessible URL.
APP_URL=http://localhost:3000
# Protects /api/internal/email-outbox; vercel.json schedules it daily at 14:00 UTC.
CRON_SECRET=generate-a-long-random-string

# DEVELOPMENT ONLY: complete bookings with a simulated card (no Stripe) as clearly labeled TEST
# reservations. Only works in `npm run dev`, never on Vercel, and only against the dev database;
# otherwise it stays off even if set. Clear them with `npm run dev:clear-test-reservations`.
INSIDE914_DEV_TEST_RESERVATIONS=false

# Required: local test prices; production MUST use launch.
INSIDE914_PRICING_MODE=test
# Optional local-only rate limit override. Leave unset in production (default 10 / 10 min).
# INSIDE914_HOLD_ATTEMPTS_MAX=1000
# Integration aliases are optional; both URLs must remain local for tests.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=local-publishable-key
# Leave RESEND_API_KEY unset for all automated tests (no external email).

# Phase F collection is LOCAL + STRIPE TEST MODE ONLY. Leave off by default.
# Requires local Supabase, matching sk_test_/rk_test_ + pk_test_ keys and a local
# Stripe CLI webhook signing secret. Never enable on Vercel or with live keys.
INSIDE914_TEST_COLLECTION=false

# Collection defaults to disabled, independent of the Stripe key mode.
# Live mode is reserved for a separately reviewed release and is blocked in code.
# Explicit local test collection also requires INSIDE914_TEST_COLLECTION=true.
INSIDE914_COLLECTION_MODE=disabled

# Account binding for future collection; never infer ownership from key prefixes.
STRIPE_ACCOUNT_ID=acct_replace_with_verified_account

# Phase 6.15: independent 32-byte encryption key (64 hex characters); retain for queued messages.
EMAIL_PAYLOAD_ENCRYPTION_KEY=
# Resend signed delivery events; configure separately before production release.
RESEND_WEBHOOK_SECRET=
# Verified owner recipient; empty disables outbound owner notifications.
ADMIN_NOTIFICATION_EMAIL=
